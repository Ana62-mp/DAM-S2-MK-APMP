# ============================================================
# GITIGNORE
# React Native / Expo + Node.js + TypeScript + Prisma/PostgreSQL
# ============================================================


# ============================================================
# NODE / NPM
# ============================================================

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/


# ============================================================
# VARIABLES DE ENTORNO / SECRETOS
# ============================================================

.env
.env.*
**/.env
**/.env.*

# Sí permitir archivos de ejemplo
!.env.example
!**/.env.example

# Archivos con secretos o credenciales
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx


# ============================================================
# TYPESCRIPT
# ============================================================

*.tsbuildinfo

dist/
**/dist/

build/
**/build/

out/
**/out/


# ============================================================
# NODE / BACKEND
# ============================================================

logs/
**/logs/

*.log

tmp/
**/tmp/

temp/
**/temp/

.cache/
**/.cache/


# ============================================================
# PRISMA
# ============================================================

# IMPORTANTE:
# NO ignorar:
# prisma/schema.prisma
# prisma/migrations/

# Prisma Client generado
src/generated/prisma/
**/src/generated/prisma/

generated/
**/generated/

# Archivos temporales Prisma
prisma/.env


# ============================================================
# BASES DE DATOS LOCALES
# ============================================================

*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal


# ============================================================
# BACKUPS / DUMPS DE POSTGRESQL
# ============================================================

*.dump
*.backup

database/*complete*.sql
database/*data*.sql
database/*backup*.sql
database/*dump*.sql

**/database/*complete*.sql
**/database/*data*.sql
**/database/*backup*.sql
**/database/*dump*.sql

# Puedes mantener versionado database-schema.sql
# porque solo contiene la estructura de la BD.


# ============================================================
# MULTER / ARCHIVOS SUBIDOS
# ============================================================

uploads/
**/uploads/

# Permite conservar una carpeta uploads vacía si usas .gitkeep
!uploads/.gitkeep
!**/uploads/.gitkeep


# ============================================================
