{
  "info": {
    "_postman_id": "inventariopro-backend-collection",
    "name": "InventarioPro - Backend CRUD",
    "description": "Colección de pruebas para el backend de InventarioPro con Express + Prisma + PostgreSQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Probar servidor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Servidor responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1 - Crear producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mouse Logitech\",\n  \"precio\": 25.99,\n  \"categoria\": \"Tecnología\",\n  \"fotoBase64\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto creado - 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.id) {",
              "    pm.collectionVariables.set('productoId', json.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET productos responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('La respuesta es un arreglo', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Editar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"precio\": 29.99,\n  \"fotoBase64\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto actualizado - 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Eliminar producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/productos/{{productoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Producto eliminado - 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}